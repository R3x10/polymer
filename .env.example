# Copia este archivo a .env y cambia los valores antes de levantar en producción.

# Base de datos
POSTGRES_DB=puselfhost
POSTGRES_USER=puselfhost
POSTGRES_PASSWORD=cambia-esta-contrasena

# Firma de las sesiones (cadena larga y aleatoria, por ejemplo: openssl rand -hex 32)
JWT_SECRET=cambia-este-secreto
JWT_EXPIRES_IN=12h

# Usuario administrador que se crea la primera vez que arranca el sistema
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=cambia-esta-contrasena
ADMIN_NAME=Administrador

# Puerto donde se publica la aplicación
HTTP_PORT=8080
